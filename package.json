{
  "name": "automationhub-saas",
  "version": "1.0.0",
  "private": true,
  "description": "AutomationHub SaaS monorepo with Next.js, NestJS, Prisma, PostgreSQL, and Docker-based orchestration.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @automationhub/web",
    "dev:api": "npm run start:dev --workspace @automationhub/api",
    "build": "npm run build --workspace @automationhub/web && npm run build --workspace @automationhub/api",
    "build:web": "npm run build --workspace @automationhub/web",
    "build:api": "npm run build --workspace @automationhub/api",
    "lint": "npm run lint --workspace @automationhub/web && npm run lint --workspace @automationhub/api",
    "lint:web": "npm run lint --workspace @automationhub/web",
    "lint:api": "npm run lint --workspace @automationhub/api",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.16.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prisma": "^5.16.2",
    "tsx": "^4.16.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
