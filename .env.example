# ============================================================
# AVA ORDER BOT — Environment Configuration
# ============================================================
# Salin file ini menjadi .env dan isi nilainya

# ============================================================
# BOT CONFIGURATION
# ============================================================
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username

# Owner Telegram IDs (pisahkan dengan koma, tanpa spasi)
# Contoh: 123456789,987654321
OWNER_IDS=123456789

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/ava_order_bot?schema=public"

# ============================================================
# SERVER & WEBHOOK
# ============================================================
NODE_ENV=production
PORT=3000
WEBHOOK_URL=https://yourdomain.com
WEBHOOK_SECRET=your_random_webhook_secret_here

# ============================================================
# PAYMENT GATEWAY — PAYDISINI
# ============================================================
# Daftar di: https://paydisini.co.id
PAYDISINI_API_KEY=your_paydisini_api_key
PAYDISINI_API_URL=https://paydisini.co.id/api/
# Metode pembayaran yang diaktifkan (pisahkan koma)
# Contoh: QRIS,BCA,BNI,MANDIRI,GOPAY,OVO,DANA,SHOPEEPAY
PAYDISINI_CHANNELS=QRIS,GOPAY,OVO,DANA,SHOPEEPAY,BCA,BNI,MANDIRI,BRI

# ============================================================
# PAYMENT GATEWAY — PAKASIR
# ============================================================
# Daftar di: https://pakasir.net
PAKASIR_API_KEY=your_pakasir_api_key
PAKASIR_API_URL=https://pakasir.net/api/v1/
PAKASIR_CALLBACK_SECRET=your_pakasir_callback_secret

# ============================================================
# TIMEZONE & LOCALE
# ============================================================
TZ=Asia/Jakarta
LOCALE=id-ID
CURRENCY=IDR

# ============================================================
# SESSION
# ============================================================
SESSION_DB_PATH=./data/sessions.json

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================================
# BACKUP
# ============================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Opsional: backup ke remote (kosongkan jika tidak dipakai)
BACKUP_REMOTE_URL=

# ============================================================
# RATE LIMITING & ANTI-SPAM
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
SPAM_THROTTLE_MS=1000

# ============================================================
# REFERRAL
# ============================================================
# Akan dapat di-override via admin panel
REFERRAL_BONUS_DEFAULT=5000

# ============================================================
# MISC
# ============================================================
# Maksimal transaksi pending sebelum expired (dalam menit)
PAYMENT_EXPIRY_MINUTES=60
# Interval polling status payment (detik)
PAYMENT_POLL_INTERVAL=15
